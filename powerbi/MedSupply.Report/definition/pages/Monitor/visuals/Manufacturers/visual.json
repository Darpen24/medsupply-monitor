{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "Manufacturers",
  "position": {
    "x": 650,
    "y": 355,
    "width": 595,
    "height": 300,
    "z": 1005,
    "tabOrder": 1005
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimProduct"
                    }
                  },
                  "Property": "manufacturer"
                }
              },
              "queryRef": "DimProduct.manufacturer",
              "nativeQueryRef": "manufacturer"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactObservation"
                    }
                  },
                  "Property": "Package Observations"
                }
              },
              "queryRef": "FactObservation.Package Observations",
              "nativeQueryRef": "Package Observations"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Reported manufacturer / authorisation holder'"
                }
              }
            }
          }
        }
      ]
    }
  }
}