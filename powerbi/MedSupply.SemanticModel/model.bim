              "type": "m",
              "expression": [
                "let",
                "    LatestFirst = Table.Sort(FactObservation, {{\"observed_at\", Order.Descending}}),",
                "    Source = Table.SelectColumns(Table.Buffer(LatestFirst), {\"product_key\", \"pzn\", \"enr\", \"product\", \"ingredient\", \"manufacturer\", \"atc\"}),",
                "    DistinctProducts = Table.Distinct(Source, {\"product_key\"})",
                "in",
