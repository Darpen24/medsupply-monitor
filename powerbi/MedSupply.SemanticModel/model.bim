        "lineageTag": "507246f2-b84f-563a-baae-ae13c06bf41e",
        "partitions": [
          {
            "name": "FactObservation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"/FactObservation.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"snapshot_id\", type text}, {\"product_key\", type text}, {\"pzn\", type text}, {\"enr\", type text}, {\"report_id\", type text}, {\"referenced_report\", type text}, {\"report_type\", type text}, {\"start_date\", type text}, {\"expected_end_date\", type text}, {\"source_updated\", type text}, {\"reason_type\", type text}, {\"product\", type text}, {\"atc\", type text}, {\"ingredient\", type text}, {\"hospital_relevant\", type text}, {\"manufacturer\", type text}, {\"reason\", type text}, {\"reason_note\", type text}, {\"first_reported\", type text}, {\"dosage_form\", type text}, {\"classification\", type text}, {\"critical_flag\", Int64.Type}, {\"content_hash\", type text}, {\"observed_at\", type text}}, \"en-GB\"),",
                "    Dates = Table.TransformColumns(Typed, {{\"start_date\", each if _ = \"\" then null else DateTime.From(Date.FromText(_, [Format=\"yyyy-MM-dd\", Culture=\"en-US\"])), type nullable datetime}, {\"expected_end_date\", each if _ = \"\" then null else DateTime.From(Date.FromText(_, [Format=\"yyyy-MM-dd\", Culture=\"en-US\"])), type nullable datetime}, {\"source_updated\", each if _ = \"\" then null else DateTime.From(Date.FromText(_, [Format=\"yyyy-MM-dd\", Culture=\"en-US\"])), type nullable datetime}, {\"first_reported\", each if _ = \"\" then null else DateTime.From(Date.FromText(_, [Format=\"yyyy-MM-dd\", Culture=\"en-US\"])), type nullable datetime}})",
                "in",
                "    Dates"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Package Observations",
            "expression": "VAR Stamp = MAX(Snapshot[observed_at]) RETURN CALCULATE(COUNTROWS(FactObservation), Snapshot[observed_at] = Stamp)",
            "formatString": "#,0",
            "displayFolder": "Monitoring"
          },
          {
            "name": "Source Reports",
            "expression": "VAR Stamp = MAX(Snapshot[observed_at]) RETURN CALCULATE(DISTINCTCOUNT(FactObservation[report_id]), Snapshot[observed_at] = Stamp)",
            "formatString": "#,0",
            "displayFolder": "Monitoring"
          },
          {
            "name": "Critical Observations",
            "expression": "CALCULATE([Package Observations], FactObservation[critical_flag] = 1)",
            "formatString": "#,0",
            "displayFolder": "Monitoring"
          },
          {
            "name": "Hospital Relevant",
            "expression": "CALCULATE([Package Observations], FactObservation[hospital_relevant] = \"ja\")",
            "formatString": "#,0",
            "displayFolder": "Monitoring"
          },
          {
            "name": "Source Rows",
            "expression": "SUM(QualityAudit[source_rows])",
            "formatString": "#,0",
            "displayFolder": "Quality"
          },
          {
            "name": "Accepted Rows",
            "expression": "SUM(QualityAudit[accepted_rows])",
            "formatString": "#,0",
            "displayFolder": "Quality"
          },
          {
            "name": "Rejected Rows",
            "expression": "SUM(QualityAudit[rejected_rows])",
            "formatString": "#,0",
            "displayFolder": "Quality"
          },
          {
            "name": "Acceptance Rate",
            "expression": "DIVIDE([Accepted Rows], [Source Rows])",
            "formatString": "0.0%",
            "displayFolder": "Quality"
          },
          {
            "name": "Snapshot Count",
            "expression": "COUNTROWS(ALL(Snapshot))",
            "formatString": "#,0",
            "displayFolder": "Monitoring"
          },
          {
            "name": "Change Rows",
            "expression": "VAR Stamp = MAX(Snapshot[observed_at]) RETURN IF([Snapshot Count] < 2, BLANK(), CALCULATE(COUNTROWS(FactChange), Snapshot[observed_at] = Stamp))",
            "formatString": "#,0",
            "displayFolder": "Monitoring"
          },
          {
            "name": "Baseline Note",
            "expression": "IF([Snapshot Count] < 2, \"Baseline only: change history needs another observation.\", \"Changes compare observations; feed absence does not establish resolution.\")",
            "displayFolder": "Monitoring"
          }
        ]
      },
